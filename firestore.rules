rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can only check their own record; create entries from the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Students never touch Firestore directly: public form reads, submissions,
    // PIN login and edits all go through server routes (firebase-admin).
    match /forms/{id} {
      allow read, write: if isAdmin();
    }
    match /applications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
  }
}
