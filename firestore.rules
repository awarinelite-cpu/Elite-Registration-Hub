rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdminUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // main admin = an admins/{uid} doc without role "sub"
    function isOwner() {
      return isAdminUser() && adminDoc().get('role', 'owner') != 'sub';
    }
    function isSub() {
      return isAdminUser() && adminDoc().get('role', 'owner') == 'sub';
    }

    // Everyone can read only their own record; accounts are created by the server (firebase-admin).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // IHS DMO accounts. The profile (ihsUsers/{uid}) is written only by the server, when the main admin creates the account;
    // an IHS user can read their own profile and nothing else outside their own reports.
    function isIhsUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/ihsUsers/$(request.auth.uid));
    }
    match /ihsUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /ihsReports/{id} {
      allow read, delete: if isIhsUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isIhsUser() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isIhsUser() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    // Students never touch Firestore directly: public form reads, submissions,
    // PIN login and edits all go through server routes (firebase-admin).
    // Main admin sees everything; a sub-admin only forms with ownerId == their uid.
    match /forms/{id} {
      allow read, delete: if isOwner() || (isSub() && resource.data.get('ownerId', '') == request.auth.uid);
      allow create: if isOwner() || (isSub() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isOwner()
        || (isSub() && resource.data.get('ownerId', '') == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid);
    }
    match /applications/{id} {
      allow read, update, delete: if isOwner()
        || (isSub() && get(/databases/$(database)/documents/forms/$(resource.data.formId)).data.get('ownerId', '') == request.auth.uid);
      allow create: if false;
    }
  }
}
