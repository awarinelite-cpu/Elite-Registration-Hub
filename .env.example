# --- Public (browser) Firebase web config, exposed to the client via Vite: Firebase Console > Project settings > Your apps ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server only ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT=
# Optional. Defaults to <project_id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
# Any long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
