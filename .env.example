# Only ONE environment variable is needed (set it in Vercel -> Settings -> Environment Variables).
# Project config (elitereghub), bucket and database are fixed in the code.
#
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on ONE line. This is a SECRET: never commit it to GitHub.
FIREBASE_SERVICE_ACCOUNT=

# Optional: override the session signing key (otherwise derived from the key above).
SESSION_SECRET=
